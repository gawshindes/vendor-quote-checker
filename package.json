{
  "name": "vendor-quote-checker",
  "version": "0.1.0",
  "description": "An AI CTO that reviews vendor proposals and emails a plain-language report with possible red flags and questions to ask.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "sample": "node scripts/make-sample-proposal.js",
    "test": "node --test",
    "check:llm": "node scripts/check-llm.js",
    "check:email": "node scripts/check-email.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": false,
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2"
  }
}
