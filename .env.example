# Copy this file to .env and fill it in. On Hostinger, add the same names as
# environment variables in the Node.js app settings instead of using a file.

# --- Server ---
PORT=3000
# The public address of this tool, used in links and emails.
BASE_URL=https://tools.example.com
NODE_ENV=production

# --- AI model ---
# openai | anthropic | gemini | mock (mock returns a sample review, for testing)
LLM_PROVIDER=anthropic
# The exact model ID from your provider's model list. Names change often, so copy it from:
#   anthropic: https://platform.claude.com/docs/en/docs/about-claude/models
#   openai:    https://developers.openai.com/api/docs/models
#   gemini:    https://ai.google.dev/gemini-api/docs/models  (for example gemini-3.8-flash)
# Then run `npm run check:llm` to confirm it works before deploying.
LLM_MODEL=
# Only the key for the provider you use is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# auto: send extracted text, or the PDF itself when it has no text (scans)
# text: always send text    pdf: always send the PDF file
LLM_INPUT=auto
# Includes the model's thinking tokens on reasoning models, so keep headroom.
LLM_MAX_OUTPUT_TOKENS=16000
LLM_TIMEOUT_SECONDS=240

# --- Email ---
# resend sends through the Resend API. smtp uses any SMTP service.
# log writes emails to data/outbox for testing.
EMAIL_TRANSPORT=resend
# Must be on a domain verified at https://resend.com/domains
EMAIL_FROM="AI CTO by Your Name <reviews@example.com>"
EMAIL_REPLY_TO=you@example.com
# Optional: get a copy of every review email.
EMAIL_BCC=
RESEND_API_KEY=
# Only used when EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# --- Your details (shown on the page, in the email and in the PDF) ---
TOOL_NAME=Vendor quote checker
AI_NAME=AI CTO
OWNER_NAME=Your Name
OWNER_TITLE=Fractional CTO
SITE_URL=https://example.com
CTA_URL=https://example.com/#contact
CONTACT_EMAIL=you@example.com
# Shown in the email footer. Commercial email laws usually require a postal address.
MAILING_ADDRESS=
REPO_URL=https://github.com/your-account/vendor-quote-checker
# Link to your privacy policy, shown under the form. Strongly recommended: you collect
# emails and send documents to an AI provider.
PRIVACY_URL=

# --- Limits ---
MAX_FILE_MB=20
MAX_PAGES=60
MAX_TEXT_CHARS=150000
LIMIT_PER_EMAIL_PER_DAY=3
LIMIT_PER_IP_PER_DAY=5
LIMIT_TOTAL_PER_DAY=100
QUEUE_CONCURRENCY=1
MAX_ATTEMPTS=2

# --- Spam check (optional, recommended): Cloudflare Turnstile ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Save the emails of people who tick "send me occasional notes" to data/subscribers.csv
SAVE_SUBSCRIBERS=true
# Where jobs and subscribers are stored. Must be writable and outside public folders.
# On Hostinger use ~/vqc-data (your home folder), which survives redeploys.
DATA_DIR=./data
